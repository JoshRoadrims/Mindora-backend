// Mindora database schema.
//
// Design principles baked in:
// 1. Identity is separated from sensitive screening content where practical,
//    so a data leak of one table doesn't automatically expose the other.
// 2. Every role (User, Professional, Admin) is a distinct model with its own
//    auth, not a single "users" table with a role flag — this makes it much
//    harder to accidentally leak professional/admin privileges to a user record.
// 3. AuditLog exists from day one. Retrofitting audit logging onto a health
//    data system after the fact is painful and error-prone — build it in now,
//    even if nothing depends on it yet.
// 4. Referral and ClinicalNote are the two most sensitive tables — access to
//    these should always go through application-level authorization checks,
//    never a raw unrestricted query.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum RiskLevel {
  LOW
  ELEVATED
  HIGH
  ACUTE
}

enum ReferralStatus {
  PENDING
  ACCEPTED
  MORE_INFO_REQUESTED
  ESCALATED
  CLOSED
}

enum AppointmentType {
  ONLINE
  IN_PERSON
}

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum ProfessionalType {
  PSYCHOLOGIST
  CLINICAL_PSYCHOLOGIST
  PSYCHIATRIST
}

enum AdminRole {
  PLATFORM_ADMIN
  CLINICAL_SAFETY_REVIEWER
  SUPPORT
}

enum DocumentType {
  LICENSE
  GOVERNMENT_ID
  DEGREE_CERTIFICATE
  OTHER
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum InstitutionType {
  EMPLOYER
  UNIVERSITY
  HEALTHCARE_PROVIDER
  INSURER
  OTHER
}

enum InstitutionStatus {
  PENDING
  ACTIVE
  INACTIVE
}

enum DeletionRequestStatus {
  PENDING
  COMPLETED
  REJECTED
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

model User {
  id                String    @id @default(uuid())
  email             String    @unique
  passwordHash      String
  fullName          String
  consentAcceptedAt DateTime?
  consentVersion    String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  checkIns      CheckIn[]
  referrals     Referral[]
  appointments  Appointment[]
  auditLogs     AuditLog[]

  @@map("users")
}

model Professional {
  id                  String            @id @default(uuid())
  email               String            @unique
  passwordHash        String
  fullName            String
  type                ProfessionalType
  bio                 String?
  qualifications      String[]
  focusAreas          String[]
  languages           String[]
  yearsExperience     Int               @default(0)
  location            String?
  feeKes              Int?
  onlineAvailable     Boolean           @default(true)
  inPersonAvailable   Boolean           @default(false)
  verified            Boolean           @default(false)
  agreementAcceptedAt DateTime?
  agreementVersion    String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  referrals       Referral[]
  appointments    Appointment[]
  clinicalNotes   ClinicalNote[]
  auditLogs       AuditLog[]
  documents       ProfessionalDocument[]

  @@map("professionals")
}

model Admin {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  fullName     String
  role         AdminRole @default(SUPPORT)
  createdAt    DateTime  @default(now())

  auditLogs    AuditLog[]

  @@map("admins")
}

// ---------------------------------------------------------------------------
// Screening & wellbeing
// ---------------------------------------------------------------------------

model CheckIn {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  riskLevel  RiskLevel
  totalScore Int
  maxScore   Int
  completedAt DateTime @default(now())

  answers    CheckInAnswer[]
  referral   Referral?

  @@index([userId, completedAt])
  @@map("check_ins")
}

model CheckInAnswer {
  id         String   @id @default(uuid())
  checkInId  String
  checkIn    CheckIn  @relation(fields: [checkInId], references: [id], onDelete: Cascade)
  domain     String
  questionId String
  value      Int

  @@map("check_in_answers")
}

// ---------------------------------------------------------------------------
// Referral & clinical workflow
// ---------------------------------------------------------------------------

model Referral {
  id             String         @id @default(uuid())
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  checkInId      String         @unique
  checkIn        CheckIn        @relation(fields: [checkInId], references: [id], onDelete: Cascade)
  professionalId String?
  professional   Professional?  @relation(fields: [professionalId], references: [id], onDelete: SetNull)
  status         ReferralStatus @default(PENDING)
  reason         String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  flags          ReferralFlag[]

  @@index([professionalId, status])
  @@map("referrals")
}

model ReferralFlag {
  id         String   @id @default(uuid())
  referralId String
  referral   Referral @relation(fields: [referralId], references: [id], onDelete: Cascade)
  label      String

  @@map("referral_flags")
}

model Appointment {
  id             String            @id @default(uuid())
  userId         String
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  professionalId String
  professional   Professional      @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  scheduledFor   DateTime
  type           AppointmentType
  status         AppointmentStatus @default(SCHEDULED)
  feeKes         Int
  meetingUrl     String?
  createdAt      DateTime          @default(now())

  @@index([professionalId, scheduledFor])
  @@index([userId, scheduledFor])
  @@map("appointments")
}

// Clinical notes deliberately have no foreign-key relation on userId (it's
// a plain reference, not an enforced FK). This is intentional: if the
// patient's User row is later deleted (see AccountDeletionRequest below),
// the note is NOT cascade-deleted along with it — a professional's own
// clinical documentation may carry separate retention obligations, and
// once the User row is gone, a bare userId with no name/email attached is
// already substantially de-identified.
model ClinicalNote {
  id             String       @id @default(uuid())
  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  userId         String
  content        String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([professionalId, userId])
  @@map("clinical_notes")
}

model ProfessionalDocument {
  id             String         @id @default(uuid())
  professionalId String
  professional   Professional   @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  type           DocumentType
  fileName       String
  filePath       String
  status         DocumentStatus @default(PENDING)
  reviewNotes    String?
  reviewedAt     DateTime?
  uploadedAt     DateTime       @default(now())

  @@index([professionalId])
  @@map("professional_documents")
}

// ---------------------------------------------------------------------------
// Safety / escalation
// ---------------------------------------------------------------------------

model SafetyAlert {
  id          String    @id @default(uuid())
  referralId  String?
  userId      String?
  riskLevel   RiskLevel
  note        String
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([riskLevel, resolvedAt])
  @@map("safety_alerts")
}

// ---------------------------------------------------------------------------
// Institutional partners
// ---------------------------------------------------------------------------

model Institution {
  id           String             @id @default(uuid())
  name         String
  type         InstitutionType
  contactName  String?
  contactEmail String?
  status       InstitutionStatus  @default(PENDING)
  notes        String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@map("institutions")
}

// ---------------------------------------------------------------------------
// Login OTP
// ---------------------------------------------------------------------------

model LoginOtp {
  id         String    @id @default(uuid())
  email      String
  role       String
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([email, role])
  @@map("login_otps")
}

// ---------------------------------------------------------------------------
// Refresh tokens
// ---------------------------------------------------------------------------

model RefreshToken {
  id         String    @id @default(uuid())
  tokenHash  String    @unique
  role       String
  accountId  String
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([accountId, role])
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------------------
// Account deletion requests — a review queue, not instant self-service
// hard-delete. See the ClinicalNote comment above for why: some data may
// need to survive a deletion request for a professional's own record-
// keeping duties, so a human (PLATFORM_ADMIN) reviews and processes each
// request deliberately rather than the system auto-purging everything.
// ---------------------------------------------------------------------------

model AccountDeletionRequest {
  id               String                 @id @default(uuid())
  role             String                 // "user" | "professional"
  accountId        String
  email            String
  reason           String?
  status           DeletionRequestStatus  @default(PENDING)
  requestedAt      DateTime               @default(now())
  processedAt      DateTime?
  processedByEmail String?

  @@index([role, accountId])
  @@map("account_deletion_requests")
}

// ---------------------------------------------------------------------------
// Audit logging — user/professional/admin relations use SetNull on delete
// so the audit trail itself survives account deletion, rather than being
// silently wiped or blocking the deletion entirely.
// ---------------------------------------------------------------------------

model AuditLog {
  id             String        @id @default(uuid())
  actorType      String
  userId         String?
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  professionalId String?
  professional   Professional? @relation(fields: [professionalId], references: [id], onDelete: SetNull)
  adminId        String?
  admin          Admin?        @relation(fields: [adminId], references: [id], onDelete: SetNull)
  action         String
  resourceType   String
  resourceId     String?
  metadata       Json?
  createdAt      DateTime      @default(now())

  @@index([resourceType, resourceId])
  @@index([createdAt])
  @@map("audit_logs")
}