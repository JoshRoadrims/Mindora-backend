# Copy this to .env for local dev (.env is gitignored — never commit real secrets)

# --- Database ---
# Local dev (matches docker-compose.yml)
DATABASE_URL="postgresql://mindora:mindora_dev_password@localhost:5432/mindora_dev"

# When you set up a test environment, use a SEPARATE database so tests
# never touch dev/prod data, e.g.:
# DATABASE_URL="postgresql://mindora:mindora_dev_password@localhost:5432/mindora_test"

# In prod this comes from your hosting provider's secrets manager, never a
# committed file — e.g. Render/Railway env vars, AWS Secrets Manager, etc.

# --- Auth ---
JWT_SECRET="replace-with-a-long-random-string-before-any-real-deploy"
JWT_EXPIRES_IN="7d"

# --- App ---
PORT=4000
NODE_ENV="development"
CORS_ORIGIN="http://localhost:5173"

